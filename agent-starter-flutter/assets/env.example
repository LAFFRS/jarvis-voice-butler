# Copy this file to assets/.env and fill it in to talk to Jarvis on your PC.
# Start the phone token server first:  .\jarvis.ps1 -Phone
# It prints the exact endpoint to use.

# http://<your PC's network address>:8787/token
LIVEKIT_TOKEN_ENDPOINT=http://192.168.1.20:8787/token
# Must match JARVIS_PHONE_KEY in jarvis_new/.env.local
JARVIS_PHONE_KEY=
