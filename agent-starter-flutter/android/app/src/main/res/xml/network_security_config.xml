<?xml version="1.0" encoding="utf-8"?>
<!-- Lets the app reach Jarvis's token server on your home network over plain
     HTTP (e.g. http://192.168.1.20:8787). LiveKit itself still uses wss://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
